# ============================================================
# Project Phoenix AI — environment configuration template
# Copy this file to .env and fill in your keys.
# ANY key left blank activates MOCK MODE for that service,
# so the whole pipeline still runs end-to-end without keys.
# ============================================================

# ---- LLM providers (script writing, research, SEO) ---------
# At least one recommended. Tried in order: OpenRouter -> Gemini -> Grok.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# Optional comma-separated fallbacks, tried only when the primary model fails.
OPENROUTER_FALLBACK_MODELS=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# ---- Stock media -------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Royalty-free music (Jamendo) ---------------------------
# Register a free app at https://devportal.jamendo.com/ to get a client id.
JAMENDO_CLIENT_ID=

# ---- v1.4 Copyright / AI / Affiliate APIs -------------------
# AcoustID: pre-upload audio fingerprint matching (free, 3 req/sec).
# https://acoustid.org/api — register, then copy your API key.
# Also install `fpcalc` (chromaprint-tools) on your system.
ACOUSTID_API_KEY=
# Hugging Face: free ML models (CTR prediction, sentiment, etc.).
# https://huggingface.co/settings/tokens — sign up, create a read token.
HUGGINGFACE_TOKEN=
# Amazon Associates + Product Advertising API (affiliate link auto-insert).
# https://affiliate-program.amazon.com/ — sign up, then enable PA API.
AMAZON_AFFILIATE_TAG=
AMAZON_PA_API_KEY=
AMAZON_PA_SECRET=
AMAZON_PA_HOST=webservices.amazon.com
AMAZON_PA_REGION=us-east-1
# Reddit API (free, 60 req/min) — used for trend discovery.
# https://www.reddit.com/prefs/apps — create a "script" app.
REDDIT_CLIENT_ID=
REDDIT_SECRET=
REDDIT_USER_AGENT=ProjectPhoenixAI/1.4
# NewsAPI.org (free, 100 req/day) — used for breaking-news topics.
NEWS_API_KEY=

# ---- v1.4 Monetization feature flags ------------------------
# Pre-upload copyright check via AcoustID (fpcalc required).
PRE_UPLOAD_COPYRIGHT_CHECK=true
COPYRIGHT_SCORE_THRESHOLD=0.85
# AI Thumbnail A/B testing — N variants + LLM CTR prediction.
THUMBNAIL_VARIANT_COUNT=5
THUMBNAIL_CTR_PREDICTION=true
# First-30-second hook analyzer.
HOOK_ANALYZER_ENABLED=true
# Best upload time AI.
UPLOAD_TIME_AI_ENABLED=true
# Long → Shorts auto-clipper.
SHORTS_AUTO_CLIP=true
SHORTS_PER_LONG=3
SHORTS_MIN_DURATION=15
SHORTS_MAX_DURATION=60

# ---- YouTube / Google OAuth ---------------------------------
# Path to the OAuth client JSON downloaded from Google Cloud Console
# (APIs to enable: YouTube Data API v3, YouTube Analytics API)
# Can be absolute or relative to project root.
GOOGLE_CLIENT_SECRETS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_DIR=data/tokens
# When true, uploads are simulated (manifest files written, nothing sent to YouTube)
YOUTUBE_DRY_RUN=true
# Default YouTube video category (27 = Education, 28 = Science & Technology,
# 22 = People & Blogs, 24 = Entertainment, 25 = News & Politics, 26 = Howto & Style)
YOUTUBE_CATEGORY_ID=27
# OAuth redirect URI — must be registered in Google Cloud Console.
# When deploying to a real domain, set this to https://your-domain/api/oauth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/callback
# Remix speech-to-text model: tiny (fastest), base (better accuracy), small/medium (slower).
WHISPER_MODEL=base
# Pollinations free image endpoint: keep requests bounded to avoid shared-service 429 bursts.
POLLINATIONS_CONCURRENCY=1
POLLINATIONS_MIN_INTERVAL=1.25
POLLINATIONS_RETRIES=3

# ---- Channel / production defaults --------------------------
CHANNEL_NAME=Project Phoenix
CHANNEL_NICHE=technology
CHANNEL_LANGUAGE=en
VIDEOS_PER_DAY=3
VIDEO_TARGET_SECONDS=150
VIDEO_RESOLUTION=1080p          # 480p | 720p | 1080p | 1440p | 4k
VIDEO_ASPECT=landscape          # landscape | square | portrait (Shorts)
VIDEO_PRIVACY=private           # private | unlisted | public (start private!)

# ---- Visual overlays (toggleable per-video too) -------------
# Captions: burned-in styled animated subtitles from word timings.
SHOW_CAPTIONS=true
# Watermark: overlay assets/logo.png in the top-right corner.
SHOW_WATERMARK=false
# Subscribe end-card: clean (NOT green-screen) card for the last ~4s.
SHOW_SUBSCRIBE_ENDCARD=false
# Persistent subscribe badge: small "Subscribe" pill shown through the video.
SHOW_SUBSCRIBE_BADGE=false
# Prepend assets/intro.mp4 / append assets/outro.mp4 when they exist.
USE_INTRO=false
USE_OUTRO=false
# Default categories (comma-separated) used by topic discovery.
DEFAULT_CATEGORIES=technology,science,space

# ---- v1.3 production mode -----------------------------------
# video_length_mode: manual | shorts | long
#   manual = use VIDEO_TARGET_SECONDS as-is
#   shorts = random 30s-180s (portrait)
#   long   = random 180s-600s (landscape)
VIDEO_LENGTH_MODE=manual
# Cinematic mode: stronger color grade, letterbox bars on landscape,
# slower fades, movie-like visual queries in the script.
CINEMATIC_MODE=true
# SEO language: tags + descriptions are ALWAYS written in this language
# regardless of the video's narration language. English maximises reach.
SEO_LANGUAGE=en
# Hide hooks in description: don't restate the curiosity gap line so
# competitors can't reverse-engineer the retention strategy.
HIDE_HOOKS_IN_DESCRIPTION=true

# ---- v1.3 YouTube monitor -----------------------------------
# Min view count for a video to be considered "winning" by the monitor.
MONITOR_MIN_VIEWS=2000000
# How many top videos the monitor analyzes per niche per day.
MONITOR_DAILY_QUOTA=50
# Region code for YouTube trending searches (ISO 3166-1 alpha-2).
MONITOR_REGION_CODE=US
# When True, the monitor extracts hooks / tags / patterns from each top video.
MONITOR_LEARN_FROM_TOP_VIDEOS=true

# ---- v1.3 upload safety -------------------------------------
# After upload: wait → check for Content ID claims → delete if claimed,
# publish if clean.
COPYRIGHT_CHECK_ENABLED=true
COPYRIGHT_WAIT_SECONDS=150
AUTO_PUBLISH_AFTER_CHECK=true
# Final privacy status after copyright check passes.
POST_CHECK_PRIVACY=unlisted

# ---- v1.3 scheduling ----------------------------------------
# When True: scheduled slots fire automatically at their time.
# When False: slots must be fired manually from the dashboard.
SCHEDULER_AUTO_TRIGGER=true

# ---- Voice (Edge-TTS) ---------------------------------------
TTS_VOICE=en-US-ChristopherNeural
# General narration rate; Urdu uses the separate slower rate below.
TTS_RATE=+0%
URDU_TTS_RATE=-8%
TTS_PITCH=+0Hz
# Final MP4 must be within the larger of these two tolerances from the target.
DURATION_TOLERANCE_SECONDS=3
DURATION_TOLERANCE_RATIO=0.08
# Maximum seconds to wait for one Edge-TTS scene before using the local fallback.
TTS_TIMEOUT_SECONDS=45

# ---- Tracking truthfulness -----------------------------------
# Keep false for real tracking. Set true only for an explicit demo/test run.
ALLOW_SIMULATED_METRICS=false

# ---- Production Safety Pack ----------------------------------
# Automatic safe upload is the default; set true only if you want manual review.
# Critical OAuth, dry-run, copyright/policy and missing-artifact gates always remain active.
APPROVAL_REQUIRED=false
NOTIFICATIONS_ENABLED=true
BACKUP_RETENTION_DAYS=14
# YouTube's default daily quota budget used for local warnings; provider remains authoritative.
YOUTUBE_DAILY_QUOTA_UNITS=10000
# Optional generic webhook for notification delivery.
NOTIFICATION_WEBHOOK_URL=

# ---- App -----------------------------------------------------
DATABASE_URL=sqlite:///data/phoenix.db
DATA_DIR=data
ASSETS_DIR=assets
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ---- Optional: explicit ffmpeg/ffprobe paths ---------------
# Set these only if auto-detection fails (rare).
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
